# 国内网络环境下的二进制下载镜像配置

# 包管理源：npmmirror（国内直连 npmjs.org 易连接假死导致 pnpm install 卡住）
registry=https://registry.npmmirror.com/

# Electron 二进制（默认从 GitHub Releases 下载，国内极慢）
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 的工具链二进制（NSIS / winCodeSign 等）
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# ffmpeg-static 的镜像无法通过 .npmrc 配置（它只读环境变量 FFMPEG_BINARIES_URL），
# 已通过项目根目录的 .pnpmfile.cjs 钩子自动改写为 npmmirror。
