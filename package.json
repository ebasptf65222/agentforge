{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal AI Agent desktop workstation",
  "author": "AgentForge",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "pack:mac": "electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:dir": "electron-vite build && electron-builder --dir"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@file-viewer/preset-lite": "^3.0.0",
    "@file-viewer/preset-office": "^3.0.0",
    "@file-viewer/vue3": "^3.0.0",
    "@github/copilot": "^1.0.75",
    "@github/copilot-sdk": "^1.0.8",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.5",
    "@vicons/ionicons5": "^0.13.0",
    "@vicons/material": "^0.13.0",
    "better-sqlite3": "^13.0.1",
    "croner": "^10.0.1",
    "dompurify": "^3.4.12",
    "exceljs": "^4.4.0",
    "langchain-mcp-adapters": "^0.6.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "openai": "^6.49.0",
    "shiki": "^4.3.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@file-viewer/vite-plugin": "^3.0.0",
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.6",
    "naive-ui": "^2.44.1",
    "pdfjs-dist": "5.4.624",
    "pinia": "^4.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "optionalDependencies": {
    "@github/copilot-darwin-arm64": "^1.0.75",
    "@github/copilot-darwin-x64": "^1.0.75",
    "@github/copilot-linux-arm64": "^1.0.75",
    "@github/copilot-linux-x64": "^1.0.75",
    "@github/copilot-linuxmusl-arm64": "^1.0.75",
    "@github/copilot-linuxmusl-x64": "^1.0.75",
    "@github/copilot-win32-arm64": "^1.0.75",
    "@github/copilot-win32-x64": "^1.0.75"
  },
  "build": {
    "appId": "com.agentforge.app",
    "productName": "AgentForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.{map,ts}"
    ],
    "extraResources": [
      {
        "from": "src/main/db/schema.sql",
        "to": "db/schema.sql"
      },
      {
        "from": "src/main/db/migrations",
        "to": "db/migrations",
        "filter": [
          "**/*.sql"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/@github/copilot-*/**",
      "out/renderer/vendor/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "AgentForge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
