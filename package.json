{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal AI Agent desktop workstation",
  "author": "AgentForge",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "pack:mac": "electron-vite build && electron-builder --mac",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:dir": "electron-vite build && electron-builder --dir"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "dompurify": "^3.4.12",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "openai": "^6.49.0",
    "shiki": "^4.3.1",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "naive-ui": "^2.44.1",
    "pinia": "^4.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.agentforge.app",
    "productName": "AgentForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.{map,ts}"
    ],
    "extraResources": [
      {
        "from": "src/main/db/schema.sql",
        "to": "db/schema.sql"
      },
      {
        "from": "src/main/db/migrations",
        "to": "db/migrations",
        "filter": ["**/*.sql"]
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Development",
      "maintainer": "AgentForge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ]
  }
}
